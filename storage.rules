rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Eğitim fotoğrafları: yalnızca sahibi yükleyip okuyabilir.
    // Cloud Functions (Admin SDK) bu kuralları görmeden okur/yazar.
    match /dating_training/{userId}/{allPaths=**} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // Üretim sonuçları: sahibi okur. Yazma yalnızca Cloud Functions'a
    // (Admin SDK bu kuralları hiç görmez) ve TEK İSTİSNA olarak ops
    // hesabının ELLE YÜKLEDİĞİ karelere açık (2026-09-22): panelden
    // kullanıcıya dışarıdan fotoğraf eklenebiliyor ve büyük dosyayı
    // callable payload'ından geçirmek yerine doğrudan buraya yüklüyoruz.
    // İzin DAR: yalnızca "manual_" ile başlayan dosya adları. Yüklenen
    // dosyanın teslim listesine girmesi yine sunucudan geçer
    // (opsAttachUploadedPhoto yolu ayrıca doğrular).
    match /dating_results/{userId}/{jobId}/{fileName} {
      allow read: if request.auth != null && request.auth.uid == userId;
      allow write: if request.auth != null
        && request.auth.token.email == 'destek@voxenai.com.tr'
        && request.auth.token.email_verified == true
        && fileName.matches('manual_.*')
        && request.resource.size < 20 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
    }

    // Alt klasörler (varsa) için okuma kuralı — yukarıdaki kural yalnızca
    // tek seviyeli dosya adını kapsıyor.
    match /dating_results/{userId}/{allPaths=**} {
      allow read: if request.auth != null && request.auth.uid == userId;
      allow write: if false;
    }

    // ÜRETİM STAGING (2026-09-22): kareler önce buraya yazılır ve
    // ops panelinden onaylanana kadar BURADA kalır. Kullanıcı bu yolu
    // OKUYAMAZ — elenen kareleri gizlemenin tek güvenilir yolu bu
    // (Firestore/Storage kuralları kullanıcıya kendi dating_results'ını ve
    // private dokümanlarını okutuyor, yani "sadece arayüzde filtrele"
    // yaklaşımı elenen kareleri ulaşılabilir bırakırdı).
    // Onaylananlar dating_results'a KOPYALANIR (bkz. opsApprovePhotos).
    match /dating_staging/{userId}/{allPaths=**} {
      allow read, write: if false;
    }

    // ELLE YÜKLEME STAGING'E GİDER (2026-09-23) — dating_results'a DEĞİL.
    // Önceki sürüm manuel yüklemeyi doğrudan teslim listesine ekliyordu;
    // admin onay ızgarasından SEÇEMİYORDU (upload = anında teslim, seçim
    // adımı atlanıyordu). Artık üretilen karelerle AYNI havuza (staging)
    // düşer, opsAttachUploadedPhoto onu job.results'a candidate olarak
    // ekler, admin normal onay akışıyla (opsApprovePhotos) seçip teslim eder.
    match /dating_staging/{userId}/{jobId}/{fileName} {
      allow write: if request.auth != null
        && request.auth.token.email == 'destek@voxenai.com.tr'
        && request.auth.token.email_verified == true
        && fileName.matches('manual_.*')
        && request.resource.size < 20 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
    }

    // GEÇİCİ: model A/B karşılaştırma çıktıları (bkz. functions/modelBakeoff.js).
    // dating_results ile aynı kural: yalnızca Cloud Functions yazar, sahibi
    // okur. Karşılaştırma bitince bu blok ve ilgili kod silinmeli.
    match /dating_bakeoff/{userId}/{allPaths=**} {
      allow read: if request.auth != null && request.auth.uid == userId;
      allow write: if false;
    }

    // Reddedilen kareler: teşhis + kullanıcıya "Elenen Kareler" panelinde
    // gösterim (2026-08-15, bkz. functions/falPhotos.js saveRejectedFrame).
    // dating_results ile aynı kural: yalnızca Cloud Functions yazar, sahibi
    // okur.
    match /dating_rejected/{userId}/{allPaths=**} {
      allow read: if request.auth != null && request.auth.uid == userId;
      allow write: if false;
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
